<UserControl x:Class="Yurei.Pages.LookupsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" 
               Margin="0,0,0,20"
               Padding="25"
               Background="{StaticResource CardBrush}"
               BorderBrush="{StaticResource NeonCyanBrush}"
               BorderThickness="2"
               CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect Color="#00d4ff" BlurRadius="20" Opacity="0.6" ShadowDepth="0"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="📊 Análisis Forense &amp; Reportes" 
                          FontSize="32"
                          FontWeight="Bold"
                          Foreground="{StaticResource NeonCyanBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00d4ff" BlurRadius="15" Opacity="0.8" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Centro de escaneo profundo, visualización de amenazas y generación de informes" 
                          Style="{StaticResource SubtitleText}"
                          Margin="0,8,0,0"
                          Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
        
        <!-- SECCIÓN 1: CONTROL DE ESCANEO -->
        <Border Grid.Row="1"
               Background="{StaticResource CardBrush}"
               BorderBrush="{StaticResource NeonCyanBrush}"
               BorderThickness="2"
               CornerRadius="12"
               Padding="25"
               Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#00d4ff" BlurRadius="15" Opacity="0.4" ShadowDepth="0"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0"
                          Text="🛡️ Motor de Búsqueda"
                          FontSize="20"
                          FontWeight="Bold"
                          Foreground="{StaticResource NeonCyanBrush}"
                          Margin="0,0,0,15"/>
                
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" >
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                        <CheckBox x:Name="OptFFlags" Content="FFlags &amp; Configs" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,15,0" FontSize="14"/>
                        <CheckBox x:Name="OptExploits" Content="Exploits &amp; Inyecciones" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,15,0" FontSize="14"/>
                        <CheckBox x:Name="OptBrowser" Content="Rastros de Navegador" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                    </StackPanel>
                    
                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="0,0,20,0" Height="30"/>

                    <Button Content="▶ Iniciar Escaneo" 
                           Style="{StaticResource ModernButton}"
                           Background="{StaticResource NeonCyanBrush}"
                           Click="RunSelectedButton_Click"
                           Margin="0,0,12,0"
                           Padding="24,10"
                           FontWeight="Bold"/>
                           
                    <Button Content="📤 Exportar a Discord" 
                           Style="{StaticResource ModernButton}"
                           Background="{StaticResource NeonPurpleBrush}"
                           Click="SendToDiscordButton_Click"
                           Margin="0,0,12,0"
                           Padding="20,10"/>
                           
                    <Button Content="🧹 Limpiar Amenazas" 
                           Style="{StaticResource ModernButton}"
                           Background="{StaticResource ErrorBrush}"
                           Click="CleanAllButton_Click"
                           Margin="0,0,12,0"
                           Padding="20,10"/>
                           
                    <TextBlock x:Name="StatusText"
                              Text="Listo para escanear..."
                              Foreground="{StaticResource TextSecondaryBrush}"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0"
                              FontSize="14"
                              FontStyle="Italic"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- SECCIÓN 2: VISUALIZACIÓN -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Panel Izquierdo: Gráfica -->
            <Border Grid.Column="0"
                   Background="{StaticResource CardBrush}"
                   BorderBrush="{StaticResource NeonPurpleBrush}"
                   BorderThickness="2"
                   CornerRadius="12"
                   Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#8338ec" BlurRadius="15" Opacity="0.4" ShadowDepth="0"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0"
                              Text="📊 Distribución"
                              FontSize="18"
                              FontWeight="Bold"
                              Foreground="{StaticResource NeonPurpleBrush}"
                              Margin="0,0,0,15"
                              HorizontalAlignment="Center"/>
                    
                    <!-- Área de gráfica -->
                    <Border Grid.Row="1"
                           Background="{StaticResource SurfaceBrush}"
                           BorderBrush="{StaticResource BorderBrush}"
                           BorderThickness="1"
                           CornerRadius="8"
                           Padding="10">
                        <Canvas x:Name="ChartCanvas" 
                               Background="Transparent"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch">
                            <TextBlock Text="Sin datos recientes"
                                      Foreground="{StaticResource TextTertiaryBrush}"
                                      FontSize="12"
                                      Canvas.Left="100"
                                      Canvas.Top="100"/>
                        </Canvas>
                    </Border>
                    
                    <StackPanel Grid.Row="2" Margin="0,15,0,0">
                        <TextBlock x:Name="ChartStats"
                                  Text="Esperando análisis..."
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="13"
                                  TextAlignment="Center"
                                  TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Panel Derecho: Tabla de Resultados -->
            <Border Grid.Column="2"
                   Background="{StaticResource CardBrush}"
                   BorderBrush="{StaticResource NeonBlueBrush}"
                   BorderThickness="2"
                   CornerRadius="12"
                   Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="#3a86ff" BlurRadius="15" Opacity="0.4" ShadowDepth="0"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0"
                           Background="{StaticResource SurfaceBrush}"
                           Padding="20,15"
                           BorderBrush="{StaticResource NeonBlueBrush}"
                           BorderThickness="0,0,0,2"
                           CornerRadius="12,12,0,0">
                        <DockPanel>
                            <TextBlock Text="📋 Hallazgos Detallados"
                                      FontSize="18"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource NeonBlueBrush}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="(Doble clic para copiar ruta)"
                                      FontSize="12"
                                      Foreground="{StaticResource TextTertiaryBrush}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right"
                                      DockPanel.Dock="Right"/>
                        </DockPanel>
                    </Border>
                    
                    <DataGrid Grid.Row="1"
                             x:Name="ResultsGrid"
                             AutoGenerateColumns="False"
                             Background="Transparent"
                             BorderThickness="0"
                             HeadersVisibility="Column"
                             GridLinesVisibility="Horizontal"
                             HorizontalGridLinesBrush="#334155"
                             RowBackground="Transparent"
                             AlternatingRowBackground="{StaticResource SurfaceBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             SelectionMode="Extended"
                             IsReadOnly="True"
                             Padding="10"
                             EnableRowVirtualization="True" 
                             EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="🔍 Categoría" Binding="{Binding Type}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="5,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn Header="📄 Elemento / Ruta" Binding="{Binding Information}" Width="3*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="Padding" Value="5,0"/>
                                        <Setter Property="ToolTip" Value="{Binding Information}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn Header="📅 Detección" Binding="{Binding Date}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="5,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn Header="ℹ Estado" Binding="{Binding Details}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource NeonPinkBrush}"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="5,0"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
