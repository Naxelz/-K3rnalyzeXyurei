<UserControl x:Class="Yurei.Pages.FFlagsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" 
               Margin="0,0,0,20"
               Padding="25"
               Background="{StaticResource CardBrush}"
               BorderBrush="{StaticResource NeonCyanBrush}"
               BorderThickness="2"
               CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect Color="#00d4ff" BlurRadius="20" Opacity="0.6" ShadowDepth="0"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="⚙️ FastFlags de Roblox" 
                          FontSize="32"
                          FontWeight="Bold"
                          Foreground="{StaticResource NeonCyanBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00d4ff" BlurRadius="15" Opacity="0.8" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Búsqueda y monitoreo de FFlags en el sistema" 
                          Style="{StaticResource SubtitleText}"
                          Margin="0,8,0,0"
                          Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
        
        <!-- SECCIÓN 1: BÚSQUEDA -->
        <Border Grid.Row="1"
               Background="{StaticResource CardBrush}"
               BorderBrush="{StaticResource NeonCyanBrush}"
               BorderThickness="2"
               CornerRadius="12"
               Padding="25"
               Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#00d4ff" BlurRadius="15" Opacity="0.4" ShadowDepth="0"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0"
                          Text="🔍 Búsqueda de FFlags"
                          FontSize="20"
                          FontWeight="Bold"
                          Foreground="{StaticResource NeonCyanBrush}"
                          Margin="0,0,0,15"/>
                
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="🔍 Buscar FFlags" 
                           Style="{StaticResource ModernButton}"
                           Background="{StaticResource NeonCyanBrush}"
                           Click="SearchButton_Click"
                           Margin="0,0,12,0"
                           Padding="20,12"/>
                    <Button Content="🔄 Monitoreo 24/7" 
                           Style="{StaticResource ModernButton}"
                           Background="{StaticResource AccentBrush}"
                           Click="MonitorButton_Click"
                           Margin="0,0,12,0"
                           Padding="20,12"/>
                    <TextBlock x:Name="StatusText"
                              Text="Listo para buscar"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              VerticalAlignment="Center"
                              Margin="20,0,0,0"
                              FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- SECCIÓN 2: RESULTADOS -->
        <Border Grid.Row="2" 
               Background="{StaticResource CardBrush}"
               BorderBrush="{StaticResource BorderBrush}"
               BorderThickness="2"
               CornerRadius="12"
               Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0"
                       Background="{StaticResource SurfaceBrush}"
                       Padding="20,15"
                       BorderBrush="{StaticResource NeonCyanBrush}"
                       BorderThickness="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                  Text="📊 Resultados Encontrados"
                                  FontSize="20"
                                  FontWeight="Bold"
                                  Foreground="{StaticResource NeonCyanBrush}"/>
                        <TextBlock Grid.Column="1"
                                  x:Name="ResultsCount"
                                  Text="0 resultados"
                                  FontSize="14"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                
                <DataGrid Grid.Row="1"
                         x:Name="ResultsGrid"
                         AutoGenerateColumns="False"
                         Background="Transparent"
                         BorderThickness="0"
                         HeadersVisibility="Column"
                         GridLinesVisibility="None"
                         RowBackground="Transparent"
                         AlternatingRowBackground="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         SelectionMode="Single"
                         IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Tipo" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TypeIcon}" FontSize="16" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Type}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="🔍 Nombre/FFlag" Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="📄 Valor/Contenido" Binding="{Binding Value}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="📍 Ubicación" Binding="{Binding Location}" Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="ℹ️ Descripción" Binding="{Binding Description}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

