<Window x:Class="Yurei.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yurei - Roblox Research Tool" 
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Barra de título personalizada -->
        <Border Grid.Row="0" 
                Background="{StaticResource SurfaceBrush}" 
                Height="32"
                MouseDown="TitleBar_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                          Text="Yurei" 
                          Foreground="{StaticResource TextPrimaryBrush}"
                          FontSize="12"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="─" 
                           Width="46" 
                           Height="32"
                           Background="Transparent"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           BorderThickness="0"
                           Click="MinimizeButton_Click"
                           Cursor="Hand"/>
                    <Button Content="□" 
                           Width="46" 
                           Height="32"
                           Background="Transparent"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           BorderThickness="0"
                           Click="MaximizeButton_Click"
                           Cursor="Hand"/>
                    <Button Content="✕" 
                           Width="46" 
                           Height="32"
                           Background="Transparent"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           BorderThickness="0"
                           Click="CloseButton_Click"
                           Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Contenido principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Sidebar de navegación -->
            <Border Grid.Column="0" 
                   Background="{StaticResource SurfaceBrush}"
                   BorderBrush="{StaticResource BorderBrush}"
                   BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Logo y título -->
                    <StackPanel Grid.Row="0" 
                               Orientation="Horizontal" 
                               Margin="20,20,20,20">
                        <TextBlock Text="👻" 
                                  FontSize="24" 
                                  Margin="0,0,12,0"/>
                        <TextBlock Text="Yurei" 
                                  FontSize="20" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Barra de búsqueda -->
                    <Border Grid.Row="1" 
                           Background="{StaticResource CardBrush}"
                           CornerRadius="6"
                           Margin="16,0,16,16"
                           Padding="12,8">
                        <Grid>
                            <TextBlock Text="🔍 Buscar..." 
                                      Foreground="{StaticResource TextTertiaryBrush}"
                                      VerticalAlignment="Center"
                                      Margin="4,0,0,0"
                                      IsHitTestVisible="False"
                                      x:Name="SearchPlaceholder"
                                      Visibility="Visible"/>
                            <TextBox Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    x:Name="SearchBox"
                                    TextChanged="SearchBox_TextChanged"
                                    KeyDown="SearchBox_KeyDown"
                                    GotFocus="SearchBox_GotFocus"
                                    LostFocus="SearchBox_LostFocus"/>
                        </Grid>
                    </Border>
                    
                    <!-- Menú de navegación -->
                    <ScrollViewer Grid.Row="2" 
                                 VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0,8,0">
                            <Button Content="🏠 Inicio" 
                                   Style="{StaticResource NavItemActiveStyle}"
                                   Click="NavButton_Click"
                                   Tag="Home"
                                   Margin="0,4"/>
                            <Button Content="🔍 Exploits" 
                                   Style="{StaticResource NavItemStyle}"
                                   Click="NavButton_Click"
                                   Tag="Exploits"
                                   Margin="0,4"/>
                            <Button Content="⚙️ FFlags" 
                                   Style="{StaticResource NavItemStyle}"
                                   Click="NavButton_Click"
                                   Tag="FFlags"
                                   Margin="0,4"/>
                            <Button Content="🔒 VPN" 
                                   Style="{StaticResource NavItemStyle}"
                                   Click="NavButton_Click"
                                   Tag="VPN"
                                   Margin="0,4"/>
                            <Button Content="📊 Lookups" 
                                   Style="{StaticResource NavItemStyle}"
                                   Click="NavButton_Click"
                                   Tag="Lookups"
                                   Margin="0,4"/>
                            <Button Content="🛠️ Herramientas" 
                                   Style="{StaticResource NavItemStyle}"
                                   Click="NavButton_Click"
                                   Tag="Tools"
                                   Margin="0,4"/>
                            <Button Content="📚 Documentación" 
                                   Style="{StaticResource NavItemStyle}"
                                   Click="NavButton_Click"
                                   Tag="Docs"
                                   Margin="0,4"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- Configuración -->
                    <Border Grid.Row="3" 
                           BorderBrush="{StaticResource BorderBrush}"
                           BorderThickness="0,1,0,0"
                           Padding="16">
                        <Button Content="⚙️ Configuración" 
                               Style="{StaticResource NavItemStyle}"
                               Click="NavButton_Click"
                               Tag="Settings"
                               HorizontalAlignment="Stretch"/>
                    </Border>
                </Grid>
            </Border>
            
            <!-- Área de contenido principal con animaciones -->
            <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                <ContentControl x:Name="ContentArea">
                    <ContentControl.Resources>
                        <!-- Animación de fade in -->
                        <Storyboard x:Key="FadeInAnimation">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                           From="0" To="1" Duration="0:0:0.3"/>
                        </Storyboard>
                        <!-- Animación de slide -->
                        <Storyboard x:Key="SlideInAnimation">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                           From="20" To="0" Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                           From="0" To="1" Duration="0:0:0.3"/>
                        </Storyboard>
                    </ContentControl.Resources>
                    <ContentControl.RenderTransform>
                        <TranslateTransform/>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
        </Grid>
        <!-- Overlay de escaneo -->
        <Grid x:Name="ScanOverlay" Visibility="Collapsed" Background="#66000000">
            <Grid>
                <Grid.Effect>
                    <BlurEffect Radius="6" />
                </Grid.Effect>
                <Border Width="420" Height="220" CornerRadius="16" Background="#141922" BorderBrush="#334155" BorderThickness="1" Opacity="0.92">
                    <StackPanel Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Ocean Security" FontSize="18" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Center" />
                        <ProgressBar x:Name="ScanProgress" Height="8" Margin="0,18,0,6" Foreground="#22D3EE" Background="#0F172A" />
                        <TextBlock x:Name="ScanStatus" Text="Validating integrity.." Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

