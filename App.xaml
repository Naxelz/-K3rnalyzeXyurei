<Application x:Class="Yurei.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Gradiente para el banner -->
            <LinearGradientBrush x:Key="BannerGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0a0a1a" Offset="0"/>
                <GradientStop Color="#1a0a2e" Offset="0.3"/>
                <GradientStop Color="#2d1b69" Offset="0.6"/>
                <GradientStop Color="#0f3460" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>

